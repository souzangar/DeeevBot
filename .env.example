# Template for the Node port's environment (docker-compose.yml's env_file).
# Copy it to .env, which is gitignored, and fill in .env, never this file:
# it is committed and keeps every secret and id empty (critical invariant 6).
# What each variable must hold: src/config/schema.ts and
# doc/guides/developer-setup.md; where each value comes from: the keyholder
# (doc/guides/operations-and-security.md, section 1.4, and
# doc/guides/fallback-drill.md). An empty required value refuses the start.
# Never define DEBUG, NODE_DEBUG or NODE_DEBUG_NATIVE here, with any value:
# each switches on debug lines past the redacting logger (NODE_DEBUG=fetch
# prints every Bot API request, the token in its path), and the port refuses
# to start with any of them.
BOT_TOKEN=
BOT_ID=
BOT_USERNAME=
# The port uses no webhook, but the shared schema requires these two: set
# fresh values of A-Z, a-z, 0-9, _ and -, never the Worker's own.
WEBHOOK_SECRET=
WEBHOOK_PATH_SEGMENT=
ADMIN_IDS=
KEYHOLDER_IDS=
# May be a new key: nothing per reporter is carried over to the port.
REPORTER_REF_KEY=
ADMIN_CHAT_ID=
MEMBERSHIP_CHAT_ID=
BROADCAST_CHAT_ID=
ALLOWED_LINK_HOSTS=instagram.com,www.instagram.com,x.com,twitter.com,www.facebook.com,facebook.com,www.tiktok.com,tiktok.com,t.me
# The keyholder's override: 1 locks the bot down. Read at start only, so a
# change takes `docker compose up -d` (a restart); /lockdown acts at once.
LOCKDOWN=
APPROVAL_GRACE_MINUTES=30
VENUE_LOCALE=fa
MARKS_PER_DAY=20000
MARKS_PER_REPORT=5000
# docker-compose.yml sets it to the volume's file. Outside Docker the default
# is ./data/div-report.sqlite, relative to the working directory.
SQLITE_PATH=
