# Template for .dev.vars: the local secrets and settings read by `wrangler dev`
# and @cloudflare/vitest-plugin. Copy it to .dev.vars (gitignored) and fill it in
# there, never here: this file is committed and keeps empty values (critical
# invariant 6). Production values are set with `wrangler secret put <NAME>`.
# What each variable must hold: src/config/schema.ts and
# doc/guides/developer-setup.md.
BOT_TOKEN=
BOT_ID=
BOT_USERNAME=
WEBHOOK_SECRET=
WEBHOOK_PATH_SEGMENT=
ADMIN_IDS=
REPORTER_REF_KEY=
ADMIN_CHAT_ID=
MIRROR_CHAT_ID=
MEMBERSHIP_CHAT_ID=
DAILY_RECIPIENT_BUDGET=
BROADCAST_BATCH_SIZE=35
BROADCAST_MESSAGES_PER_SECOND=25
APPROVAL_GRACE_MINUTES=5
MARKS_PER_DAY=20000
