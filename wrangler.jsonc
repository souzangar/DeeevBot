// wrangler.jsonc: the Cloudflare Workers deployment of div-report
// (doc/architecture/adr-0001-runtime-and-hosting.md).
//
// No secret ever lives here (critical invariant 6). Production secrets are
// set with `wrangler secret put <NAME>`; local ones go in .dev.vars, which is
// gitignored (template with empty values: .dev.vars.example). The variables
// are validated by src/config/schema.ts.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "div-report",
  "main": "src/worker.ts",
  // The newest date the toolchain accepted when set: miniflare (behind
  // `wrangler dev` and @cloudflare/vitest-plugin) and workerd 1.20261023.1
  // refuse any date after today's UTC date, and that workerd's own ceiling is
  // 2026-10-30. Raise it to at most today's date, then run the workers tests.
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  // No usage telemetry from the toolchain either: the owner's stance, not rule 6.
  "send_metrics": false,

  // ADR 0004 (storage, scheduling and the single post): D1 behind the SqlDb
  // port is the only store, holding drafts, reports, approvals,
  // admin_prompts, reporter_stats, counters, stats, jobs and meta
  // (ADR 0006); there is no Durable Object. The plain SQL migrations in
  // migrations/ are applied by `npm run migrate:local` locally and by
  // `wrangler d1 migrations apply` on Cloudflare. The all-zero database_id
  // is a placeholder: the real id is deployment configuration.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "div-report",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // ADR 0004 ("Scheduling"): ONE cron, every minute. Its run
  // (src/broadcast/tick.ts) posts the due approved report, runs the due edit
  // jobs and, by the minute, reconciliation on every 15th minute, the
  // retention job at 00:15 UTC (after the Free plan's daily caps reset at
  // 00:00 UTC) and the monthly snapshot on the first day at 06:00 UTC; the
  // Worker runs nothing for any other expression.
  // The Free plan's five Cron Triggers are counted per ACCOUNT, not per
  // Worker, and so is its daily request meter, on which each cron run counts
  // (1,440 a day here): the account runs no other cron Worker beside this
  // one, the deployed probe (wrangler.probe.jsonc) aside while it exists: it
  // is deployed once and deleted after its run (ADR 0004). src/worker.test.ts
  // pins this list to the one expression.
  "triggers": { "crons": ["* * * * *"] },

  // Critical invariant 6: the platform's invocation logs are logs. Workers
  // observability stays OFF: whether its invocation logs record request
  // headers, the webhook's secret token among them, is not settled
  // (doc/reference/cloudflare-free-plan-limits.md, "Open measurements"). It
  // is turned on only deliberately, to debug, and off again right after
  // (doc/guides/operations-and-security.md, section 4); src/worker.test.ts
  // pins it off, so turning it on is a visible change.
  "observability": { "enabled": false },

  // Nothing here: every secret and every deployment value comes from
  // `wrangler secret put` (production) or .dev.vars (local).
  "vars": {}
}
