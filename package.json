{
  "name": "div-report",
  "private": true,
  "description": "Telegram bot for reviewed reports of harmful social-media links, each approved one posted once to one channel with per-platform reporting instructions.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && npm run lint",
    "test": "vitest run --project unit --project workers",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:invariants": "vitest run --project invariants",
    "dev": "wrangler dev",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "probe:dry-run": "wrangler deploy --dry-run --config wrangler.probe.jsonc --outdir .wrangler/probe-dry-run",
    "migrate:local": "wrangler d1 migrations apply div-report --local",
    "port": "node --import ./src/node-hooks.ts src/node.ts"
  },
  "dependencies": {
    "@grammyjs/runner": "2.0.3",
    "grammy": "1.46.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261028.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "wrangler": "4.154.0"
  }
}
